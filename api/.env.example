# =====================================================================
# api/.env.example — copy to api/.env.local and fill in
# =====================================================================

# ---- Supabase ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# ---- NEXT_PUBLIC_ 副本（仅 client-side bundle 可见；callback 页面用）----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- LLM (provider-agnostic) ----
# 切换 provider 只改这三行：
#   LLM_PROVIDER / LLM_API_KEY / LLM_MODEL_*（模型名可省略，自动按 provider 默认填）
#
# 可选 provider：
#   openai     OpenAI 官方（gpt-4o-mini / gpt-4o）—— 需翻墙
#   deepseek   DeepSeek（deepseek-chat V3 / deepseek-reasoner R1）—— 国内最便宜
#   dashscope  Aliyun 通义千问（qwen-turbo / qwen-plus / qwen-max）—— 阿里云开票
#   moonshot   Moonshot Kimi（moonshot-v1-8k/32k/128k）—— 长上下文王
#   zhipu      智谱 GLM（glm-4-flash / glm-4-air / glm-4-plus）—— 学生友好
#   MiniMax    MiniMax（MiniMax-Text-01）—— 走自家协议，adapter 自动转
LLM_PROVIDER=deepseek
LLM_API_KEY=
# 可选 — 留空则按 LLM_PROVIDER 自动填
# LLM_BASE_URL=
# LLM_MODEL_MINI=
# LLM_MODEL_PRO=
# LLM_MODEL_REASON=

# ---- Upstash Redis ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Paddle Billing ----
# PADDLE_ENVIRONMENT: 强校验，必须是 "sandbox" 或 "live"
#   - sandbox: Paddle 沙盒环境（测试用），价格走 test_ cards
#   - live:    生产环境，价格会被实际收取
# ⚠️ 不要默认成 sandbox — 写错会连错账号。env.ts 在缺失/拼错时会立即抛错。
PADDLE_ENVIRONMENT=sandbox

# PADDLE_API_KEY: Paddle Dashboard → Developer tools → API keys
#   - 沙盒以 pdl_sdbx_apikey_ 开头
#   - 生产以 pdl_live_apikey_ 开头
# ⚠️ 这是服务端机密，只能 import 自 ~/lib/* 服务端代码，永远不出现在 'use client' 中。
PADDLE_API_KEY=

# PADDLE_WEBHOOK_SECRET: Paddle Dashboard → Webhooks → 选 destination → "endpoint_secret_key"
# ⚠️ 只在创建/重置时显示一次，找不到就重置（但会作废现有签名）
PADDLE_WEBHOOK_SECRET=

# PADDLE_CLIENT_TOKEN: Paddle Dashboard → Developer tools → Authentication → "Client-side tokens"
#   - 沙盒以 test_ 开头
#   - 生产以 live_ 开头
PADDLE_CLIENT_TOKEN=

# ---- 6 个 Price ID ----
PADDLE_PRICE_STARTER_MONTHLY=
PADDLE_PRICE_STARTER_ANNUAL=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_ANNUAL=
PADDLE_PRICE_ADVANCED_MONTHLY=
PADDLE_PRICE_ADVANCED_ANNUAL=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CHROME_STORE_URL=

# ---- Quotas (可选) ----
FREE_DAILY_LIMIT=5
PRO_DAILY_LIMIT=200

# ---- Optional ----
LOG_LEVEL=info
